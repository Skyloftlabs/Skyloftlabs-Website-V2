---
layout: layouts/page.njk
pagination:
  data: consulting
  size: 1
  alias: offering
permalink: "/pages/consulting/{{ offering.slug }}/index.html"
title: "{{ offering.name }}"
---

<h1>{{ offering.name }}</h1>
<p class="muted">{{ offering.summary }}</p>

{% if offering.outcomes %}
  <h2>What you get</h2>
  <ul>
    {% for o in offering.outcomes %}
      <li>{{ o }}</li>
    {% endfor %}
  </ul>
{% endif %}

<div class="cta-row" style="margin-top: 24px;">
  <a class="btn primary" href="{{ offering.cta.url }}">{{ offering.cta.label }}</a>
  <a class="btn ghost" href="/pages/consulting/">Back to consulting</a>
</div>
